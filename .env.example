# =============================================================================
# Autoprocs Dispatcher — variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha os valores.
# Nunca commit `.env.local`. Veja .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (cliente + server)
# Pegue em: https://supabase.com/dashboard/project/<id>/settings/api
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# -----------------------------------------------------------------------------
# Meta / WhatsApp Cloud API
# App ID/Secret: https://developers.facebook.com/apps/<app-id>/settings/basic/
# Embedded Signup Config ID: criado em WhatsApp > Embedded Signup
# -----------------------------------------------------------------------------
META_APP_ID="<meta-app-id>"
META_APP_SECRET="<meta-app-secret>"
META_EMBEDDED_SIGNUP_CONFIG_ID="<config-id>"
# Configuration ID separada, criada com o onboarding type "WhatsApp Business
# app users" (Coexistência) — permite conectar um número que já usa o app
# WhatsApp Business mantendo-o ativo ao lado da Cloud API.
META_COEXISTENCE_CONFIG_ID="<coexistence-config-id>"
META_GRAPH_API_VERSION="v21.0"
META_VERIFY_TOKEN="<random-string-for-webhook-verification>"

# URL que já recebia os webhooks da Meta antes deste app (ex: n8n). Opcional:
# se preenchida, cada evento é repassado pra lá além de ser processado aqui,
# pra não quebrar a automação antiga ao trocar a Callback URL na Meta.
META_WEBHOOK_FORWARD_URL=""

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Notificação push (opcional) — avisa os owners quando a transmissão termina.
# Gere as chaves com: npx web-push generate-vapid-keys
# Sem elas o app funciona normal; só o push fica desligado.
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:voce@empresa.com"
# A mesma chave pública precisa chegar ao navegador pra ele assinar o push.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
